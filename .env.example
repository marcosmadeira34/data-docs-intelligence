# Copie para .env e ajuste. Nunca versione o .env.

# --- Obrigatórios em produção ---
DDI_ENVIRONMENT=development            # production exige DDI_SECRET_KEY próprio
DDI_SECRET_KEY=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
POSTGRES_PASSWORD=troque-esta-senha
DDI_COOKIE_SECURE=false                # true atrás de HTTPS

# --- Acesso ---
DDI_ALLOW_SIGNUP=true                  # false: organizações só por provisionamento
# DDI_DEMO_PASSWORD=                   # senha dos usuários de `seed-demo`

# --- Armazenamento (local em dev; s3 em produção) ---
DDI_STORAGE_BACKEND=local
# DDI_S3_BUCKET=
# DDI_S3_ENDPOINT_URL=                 # MinIO/RustFS etc.; vazio para AWS
# DDI_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- IA opcional (sem chave, apenas heurísticas determinísticas) ---
DDI_AI_PROVIDER=none                   # none | anthropic
# DDI_ANTHROPIC_API_KEY=
# DDI_ANTHROPIC_MODEL=claude-opus-5-5
# DDI_AI_SEND_SAMPLE_VALUES=false      # true envia até 3 amostras mascaradas por coluna

# --- Limites e retenção (opcionais; padrões em backend/app/core/config.py) ---
# DDI_MAX_UPLOAD_BYTES=52428800
# DDI_FILE_RETENTION_DAYS=180
# DDI_JOB_INLINE_MAX_BYTES=2097152
# DDI_MAX_CONCURRENT_JOBS_PER_ORG=5

# --- Portas locais do Compose ---
# DDI_WEB_PORT=3010
# DDI_API_PORT=8010
# DDI_DB_PORT=5442
